version: '3.8'

services:
  # PostgreSQL for metadata
  postgres:
    image: postgres:15-alpine
    container_name: medenroll834-postgres
    environment:
      POSTGRES_USER: medenroll
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-changeme}
      POSTGRES_DB: medenroll834
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./04_infrastructure/02_sql/02_oltp:/docker-entrypoint-initdb.d
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U medenroll"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - medenroll-network

  # Airflow services (simplified for local dev)
  airflow-webserver:
    build:
      context: .
      dockerfile: deploy/docker/airflow.Dockerfile
    container_name: medenroll834-airflow-webserver
    depends_on:
      - postgres
    environment:
      AIRFLOW__CORE__EXECUTOR: LocalExecutor
      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://medenroll:${POSTGRES_PASSWORD:-changeme}@postgres/medenroll834
      AIRFLOW__CORE__FERNET_KEY: ${AIRFLOW_FERNET_KEY}
      AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION: 'true'
      AIRFLOW__CORE__LOAD_EXAMPLES: 'false'
      AIRFLOW__API__AUTH_BACKENDS: 'airflow.api.auth.backend.basic_auth'
    volumes:
      - ./05_orchestration/airflow/01_dags:/opt/airflow/dags
      - ./05_orchestration/airflow/04_plugins:/opt/airflow/plugins
      - ./logs:/opt/airflow/logs
    ports:
      - "8080:8080"
    command: webserver
    healthcheck:
      test: ["CMD", "curl", "--fail", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 5
    networks:
      - medenroll-network

  airflow-scheduler:
    build:
      context: .
      dockerfile: deploy/docker/airflow.Dockerfile
    container_name: medenroll834-airflow-scheduler
    depends_on:
      - postgres
    environment:
      AIRFLOW__CORE__EXECUTOR: LocalExecutor
      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://medenroll:${POSTGRES_PASSWORD:-changeme}@postgres/medenroll834
      AIRFLOW__CORE__FERNET_KEY: ${AIRFLOW_FERNET_KEY}
    volumes:
      - ./05_orchestration/airflow/01_dags:/opt/airflow/dags
      - ./05_orchestration/airflow/04_plugins:/opt/airflow/plugins
      - ./logs:/opt/airflow/logs
    command: scheduler
    healthcheck:
      test: ["CMD-SHELL", "airflow jobs check --job-type SchedulerJob"]
      interval: 30s
      timeout: 10s
      retries: 5
    networks:
      - medenroll-network

  # MinIO for local S3-compatible storage
  minio:
    image: minio/minio:latest
    container_name: medenroll834-minio
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: ${MINIO_PASSWORD:-minioadmin123}
    ports:
      - "9000:9000"
      - "9001:9001"
    volumes:
      - minio_data:/data
    command: server /data --console-address ":9001"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 20s
      retries: 3
    networks:
      - medenroll-network

  # Prometheus for monitoring
  prometheus:
    image: prom/prometheus:latest
    container_name: medenroll834-prometheus
    ports:
      - "9090:9090"
    volumes:
      - ./09_monitoring/prometheus.yml:/etc/prometheus/prometheus.yml
      - prometheus_data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
    networks:
      - medenroll-network

  # Grafana for visualization
  grafana:
    image: grafana/grafana:latest
    container_name: medenroll834-grafana
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_PASSWORD:-admin}
    volumes:
      - grafana_data:/var/lib/grafana
      - ./09_monitoring/grafana/dashboards:/etc/grafana/provisioning/dashboards
      - ./09_monitoring/grafana/datasources:/etc/grafana/provisioning/datasources
    networks:
      - medenroll-network

networks:
  medenroll-network:
    driver: bridge

volumes:
  postgres_data:
  minio_data:
  prometheus_data:
  grafana_data:
