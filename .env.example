# MedEnroll834 - Environment template (copy to .env and fill in secrets)

# --- Blob storage (S3-compatible; POC landing/archive/report layer) ---
BLOB_STORAGE_TOKEN=

# AWS (S3 landing / archive / reports) - enterprise target; not used by the
# current blob-storage-based DAG unless you migrate the landing layer to S3
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# PostgreSQL OLTP database (target for the OLTP load step)
OLTP_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Databricks (medallion job + OLAP + reporting + Genie)
DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
DATABRICKS_WAREHOUSE_ID=
GENIE_SPACE_ID=

# Airflow UI
# Airflow 3.x defaults to SimpleAuthManager (not FAB). The `airflow users create`
# CLI is FAB-only and errors on SimpleAuthManager, so the admin login is wired via
# AIRFLOW__CORE__SIMPLE_AUTH_MANAGER__USERS and the bind-mounted
# airflow_passwords.json.generated file in docker-compose.yaml. Set these two
# values and they will be applied on the next `docker compose up`.
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# MedEnroll834 pipeline logging (src/medenroll834/common/logging.py)
# MED834_LOG_LEVEL: DEBUG/INFO/WARNING/ERROR (default INFO)
# MED834_LOG_FILE: optional path; when set, logs also rotate to this file
#   (in addition to stdout, which Airflow/Databricks already capture)
MED834_LOG_LEVEL=INFO
MED834_LOG_FILE=


