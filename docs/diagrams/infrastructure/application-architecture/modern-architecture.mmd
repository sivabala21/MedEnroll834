
flowchart LR

    %% ============================================================
    %% SOURCE
    %% ============================================================

    subgraph SOURCE["SOURCE SYSTEM"]
        direction TB

        EDI["834 EDI File"]
    end


    %% ============================================================
    %% STORAGE
    %% ============================================================

    subgraph STORAGE["CLOUD STORAGE"]
        direction TB

        S3["Amazon S3<br/>Landing / Data Lake"]
    end


    %% ============================================================
    %% ORCHESTRATION
    %% ============================================================

    subgraph ORCH["ORCHESTRATION"]
        direction TB

        AF["Apache Airflow"]

        D1["Ingestion Job"]
        D2["Validation Job"]
        D3["OLTP Load Job"]
        D4["Lakehouse Transform Job"]
        D5["DQ / Reconciliation Job"]

        AF --> D1
        AF --> D2
        AF --> D3
        AF --> D4
        AF --> D5
    end


    %% ============================================================
    %% DATABRICKS
    %% ============================================================

    subgraph DBX["DATABRICKS DATA PLATFORM"]
        direction TB

        P["PySpark<br/>Distributed Processing"]

        B["BRONZE<br/>Raw Delta"]

        SV["SILVER<br/>Validated & Conformed Delta"]

        G["GOLD<br/>Business-Ready Delta"]

        P --> B
        B --> SV
        SV --> G
    end


    %% ============================================================
    %% OPERATIONAL DATABASE
    %% ============================================================

    subgraph OLTP["OPERATIONAL DATA STORE"]
        direction TB

        PG["PostgreSQL<br/>OLTP"]

        T1["Member"]
        T2["Subscriber"]
        T3["Employer Group"]
        T4["Benefit Plan"]
        T5["Enrollment"]
        T6["Transaction / Reject"]

        PG --- T1
        PG --- T2
        PG --- T3
        PG --- T4
        PG --- T5
        PG --- T6
    end


    %% ============================================================
    %% ANALYTICS
    %% ============================================================

    subgraph ANALYTICS["ANALYTICAL PLATFORM"]
        direction TB

        SQL["Databricks SQL"]

        DIM["DIM_*"]
        FACT["FACT_ENROLLMENT"]

        SQL --> DIM
        SQL --> FACT
    end


    %% ============================================================
    %% CONSUMPTION
    %% ============================================================

    subgraph CONSUMPTION["CONSUMPTION"]
        direction TB

        BI["BI / Dashboards"]
        GENIE["Natural Language Analytics<br/>AI / Genie"]
    end


    %% ============================================================
    %% PRIMARY DATA FLOW
    %% ============================================================

    EDI --> S3

    S3 --> D1

    D1 --> P

    P --> D2

    D2 --> D3
    D2 --> D4

    D3 --> PG

    D4 --> B

    G --> SQL

    SQL --> BI
    SQL --> GENIE


    %% ============================================================
    %% RECONCILIATION
    %% ============================================================

    PG -.-> D5
    G -.-> D5

    D5 -.-> AF


    %% ============================================================
    %% STYLING
    %% ============================================================

