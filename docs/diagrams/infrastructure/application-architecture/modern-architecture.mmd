    classDef compute fill:#F5F3FF,stroke:#7C3AED,color:#4C1D95,stroke-width:2px;

    classDef bronze fill:#FFF7ED,stroke:#C2410C,color:#7C2D12,stroke-width:1.5px;

    classDef silver fill:#F8FAFC,stroke:#64748B,color:#334155,stroke-width:1.5px;

    classDef gold fill:#F0FDFA,stroke:#0F766E,color:#134E4A,stroke-width:2px;

    classDef database fill:#EFF6FF,stroke:#2563EB,color:#1E3A8A,stroke-width:2px;

    classDef analytics fill:#F0FDFA,stroke:#0F766E,color:#134E4A,stroke-width:1.5px;

    classDef consumption fill:#F5F3FF,stroke:#7C3AED,color:#4C1D95,stroke-width:1.5px;


    class EDI source;

    class S3 storage;

    class AF,D1,D2,D3,D4,D5 orchestration;

    class P compute;

    class B bronze;

    class SV silver;

    class G gold;

    class PG,T1,T2,T3,T4,T5,T6 database;

    class SQL,DIM,FACT analytics;

    class BI,GENIE consumption;


    style SOURCE fill:#FFFFFF,stroke:#94A3B8,stroke-width:1.5px

    style STORAGE fill:#FFFFFF,stroke:#C2410C,stroke-width:1.5px

    style ORCH fill:#FFFFFF,stroke:#2563EB,stroke-width:2px

    style DBX fill:#FFFFFF,stroke:#7C3AED,stroke-width:2px

    style OLTP fill:#FFFFFF,stroke:#2563EB,stroke-width:2px

    style ANALYTICS fill:#FFFFFF,stroke:#0F766E,stroke-width:2px

